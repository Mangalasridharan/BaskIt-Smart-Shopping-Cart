# Server Port (Render sets this dynamically, defaults to 8000 locally)
PORT=8000

# MongoDB Connection String (from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart-shopping-cart?retryWrites=true&w=majority

# JWT Authentication Secret
ACCESS_TOKEN_SECRET=your_jwt_secret_key_here

# Adafruit IO Integration (Optional for physical exit gate & telemetry)
AIO_USERNAME=Mangal
AIO_KEY=your_adafruit_io_key
