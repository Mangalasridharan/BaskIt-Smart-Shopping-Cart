# Server Port (Render sets this dynamically, defaults to 8000 locally)
PORT=8000

# MongoDB Connection String (from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart-shopping-cart?retryWrites=true&w=majority

# JWT Authentication Secret
ACCESS_TOKEN_SECRET=your_jwt_secret_key_here

# Adafruit IO Integration (Optional for physical exit gate & telemetry)
AIO_USERNAME=Mangal
AIO_KEY=your_adafruit_io_key
# How long the barrier stays open after a pass is scanned, in milliseconds.
# The backend writes ON, waits, then writes OFF to the `payment` feed.
GATE_OPEN_MS=4000

# Public URL of this backend. Used to build the QR code shown after payment so
# a phone can scan it. On Render set this to https://<your-service>.onrender.com
# (localhost only works when the scanner is on the same machine).
PUBLIC_BACKEND_URL=http://localhost:8000

# Stripe Checkout (hosted payment page)
# Get a test key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here
# Currency used for Checkout line items (lowercase ISO code)
STRIPE_CURRENCY=inr
# Optional minimum cart total in major units, checked before calling Stripe.
# Stripe requires a US$0.50-equivalent total, which is roughly ₹50 when paying
# in INR from a USD-settling account.
STRIPE_MIN_CHARGE=50
# Where Stripe sends the shopper back after paying / cancelling
FRONTEND_URL=http://localhost:5173

# Google OAuth (Google Cloud Console OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID=your_google_client_id_here
